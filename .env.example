# ==========================================
# HazWaste Sorter - Environment Configuration
# ==========================================

# Paste your Gemini API key from Google AI Studio here:
GEMINI_API_KEY=your_gemini_api_key_here

# Model to use (default: gemini-3.8-flash)
GEMINI_MODEL=gemini-3.8-flash

# Supervisor 4-digit PIN (demo-level security)
SUPERVISOR_PIN=1234

# Flask Secret Key for session handling (can be any random string)
SECRET_KEY=hazwaste-sorter-prototype-secret-2026
